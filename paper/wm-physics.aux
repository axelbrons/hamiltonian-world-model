\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.3.3}Conservation de l'Énergie Totale sur Long Horizon ($T=100$)}{8}{subsubsection.4.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Conservation de l'énergie physique sur un horizon étendu de 100 pas ($t \in [0, 20]$ s). (a) Énergie totale $\mathcal  {H}(z_t)$ au cours du temps. Notre modèle Leapfrog (ligne bleue continue) reste rigoureusement plat et borné autour de l'énergie initiale ($H_0 = -13.19$), alors que la baseline non-symplectique dissipe artificiellement l'énergie et qu'Euler explose. (b) Erreur absolue d'énergie $|\mathcal  {H}(z_t) - H_0|$ en échelle logarithmique, confirmant l'absence de dérive séculaire cumulative pour Leapfrog.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:energy_comparison}{{5}{8}{Conservation de l'énergie physique sur un horizon étendu de 100 pas ($t \in [0, 20]$ s). (a) Énergie totale $\mathcal {H}(z_t)$ au cours du temps. Notre modèle Leapfrog (ligne bleue continue) reste rigoureusement plat et borné autour de l'énergie initiale ($H_0 = -13.19$), alors que la baseline non-symplectique dissipe artificiellement l'énergie et qu'Euler explose. (b) Erreur absolue d'énergie $|\mathcal {H}(z_t) - H_0|$ en échelle logarithmique, confirmant l'absence de dérive séculaire cumulative pour Leapfrog}{figure.5}{}}
